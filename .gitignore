# ─────────────────────────────────────────────────────────────────────────────
# AIRRIDE — Comprehensive .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env

# Firebase service account keys
serviceAccount*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt

# ── Node.js ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json

# ── Build & Distribution ───────────────────────────────────────────────────
dist/
build/
.output/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
log/

# ── OS & Editor ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# ── Test Artifacts ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Temp & Scratch ─────────────────────────────────────────────────────────
tmp/
temp/
.tmp/
*.tmp

# ── Backend specific ───────────────────────────────────────────────────────
apps/backend/e2e_audit.js
apps/backend/test_*.js
apps/backend/monitor.js

# ── Flutter (future) ───────────────────────────────────────────────────────
flutter/
*.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
